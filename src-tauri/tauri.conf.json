{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocita",
  "version": "0.0.0",
  "identifier": "com.sim40702.velocita",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Velocità",
        "width": 960,
        "height": 600,
        "minWidth": 820,
        "minHeight": 540,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Italian"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQ0JCNEQzQkJBNUMwREYKUldUZndLVzcwN1RManNYVXV1dDd5a3FsVVI1cnQ4Y21DSHNBaE1GaGlKYWsrMllWOHBpQ3Mxbi8K",
      "endpoints": [
        "https://github.com/sim40702-debug/velocita/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
