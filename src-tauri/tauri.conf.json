{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocita",
  "version": "0.0.0",
  "identifier": "com.sim40702.velocita",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Velocità",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["Italian"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNjkwNDY3MDlBMDdDRDgKUldUWWZLQUpad1JwM1BtdWFDK09QWHA4MGxEcjJWc2xNVktwVGJxMmxRL2dCOEtRcjIxeUpmcnkK",
      "endpoints": [
        "https://github.com/sim40702-debug/velocita/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
